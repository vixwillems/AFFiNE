# AFFiNE revision (canary has the Qwen code changes)
AFFINE_REVISION=canary

# Server port
PORT=3010

# External URL (set this for production)
# AFFINE_SERVER_EXTERNAL_URL=https://affine.yourdomain.com

# Database
DB_USERNAME=affine
DB_PASSWORD=change-me-to-a-secure-password
DB_DATABASE=affine

# Persistence paths
DB_DATA_LOCATION=~/.affine/self-host/postgres/pgdata
UPLOAD_LOCATION=~/.affine/self-host/storage
CONFIG_LOCATION=~/.affine/self-host/config

# === Qwen AI via LiteLLM ===
# LiteLLM proxy address (the VM running LiteLLM + Ollama)
COPILOT_OPENAI_BASE_URL=http://192.168.0.253:4000/v1
# Any non-empty value; LiteLLM's master_key is the actual credential
COPILOT_OPENAI_API_KEY=sk-liteLLM

# Fork image tag
IMAGE_TAG=ghcr.io/vixwillems/affine:qwen
